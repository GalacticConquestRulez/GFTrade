# Copy to .env and fill in. NEVER commit the real .env.

# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user ids allowed to control the bot, comma-separated —
# message @userinfobot to get yours. Everyone listed shares the same
# wallet/positions/settings and receives every alert. The FIRST id is the
# primary owner: only they can export the wallet's private key.
# Example: TELEGRAM_USER_IDS=111111111,222222222
TELEGRAM_USER_IDS=

# true = simulate everything (default, start here). false = trade real SOL.
DRY_RUN=true

# Public RPC works for dry-run; use a paid RPC (Helius/QuickNode/Triton)
# before going live — public mainnet-beta rate-limits and drops under load.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional standby RPC, used only when the primary errors. Pair a fast
# endpoint with a stable one — e.g. primary = Helius Gatekeeper edge
# gateway (https://beta.helius-rpc.com/?api-key=YOUR_KEY), fallback =
# the standard mainnet endpoint (https://mainnet.helius-rpc.com/?api-key=YOUR_KEY).
#SOLANA_RPC_FALLBACK_URL=

# Optional: enables the pre-buy honeypot check (Helius Enhanced
# Transactions API, 100 credits per new mint — only spent when buying).
# Left blank, the key is taken from a Helius SOLANA_RPC_URL automatically.
#HELIUS_API_KEY=

# Client-side RPC requests-per-second ceiling. Default 8 sits just under
# Helius's free-tier 10/s; raise to ~45 on the $49 Developer plan (50/s)
# for faster sweeps. 0 disables the limiter.
#RPC_MAX_RPS=8

# Optional but recommended: free key from https://portal.jup.ag (60 req/min).
# Without it the keyless lite-api.jup.ag endpoint is used.
JUPITER_API_KEY=

# Optional overrides
#SCAN_INTERVAL_SECONDS=90
#WALLET_KEYFILE=wallet.json
#STATE_FILE=state.json
