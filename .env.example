# Copy to .env and fill in. NEVER commit the real .env.

# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user ids allowed to control the bot, comma-separated —
# message @userinfobot to get yours. Everyone listed shares the same
# wallet/positions/settings and receives every alert. The FIRST id is the
# primary owner: only they can export the wallet's private key.
# Example: TELEGRAM_USER_IDS=111111111,222222222
TELEGRAM_USER_IDS=

# true = simulate everything (default, start here). false = trade real SOL.
DRY_RUN=true

# Public RPC works for dry-run; use a paid RPC (Helius/QuickNode/Triton)
# before going live — public mainnet-beta rate-limits and drops under load.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# With a Helius mainnet URL above, nothing more is needed: the bot uses
# Helius's faster Gatekeeper edge gateway as the primary and the URL above
# as the automatic standby, reusing the same key. Set HELIUS_GATEKEEPER=false
# to stay on plain mainnet, or set both ends yourself here.
#HELIUS_GATEKEEPER=true
#SOLANA_RPC_FALLBACK_URL=

# Optional: enables the pre-buy honeypot check (Helius Enhanced
# Transactions API, 100 credits per new mint — only spent when buying).
# Left blank, the key is taken from a Helius SOLANA_RPC_URL automatically.
#HELIUS_API_KEY=

# Client-side RPC requests-per-second ceiling. Default 45 suits the $49
# Helius Developer plan (50/s); drop to 8 on the free tier (10/s).
# 0 disables the limiter.
#RPC_MAX_RPS=45

# JSON-RPC array batching. Calls are sent many-per-request, which is what
# lets a 140-coin sweep cost ~3 HTTP requests instead of ~840. Providers
# differ on whether an array counts as one request or N against the rate
# limit — if you see 429s, set RPC_BATCH_COUNTS_AS=size.
#RPC_BATCH_SIZE=100
#RPC_BATCH_COUNTS_AS=1

# Safety verdicts persist here so a restart doesn't re-vet everything.
#SAFETY_CACHE_DB=safety_cache.db

# Optional but recommended: free key from https://portal.jup.ag (60 req/min).
# Without it the keyless lite-api.jup.ag endpoint is used.
JUPITER_API_KEY=

# Optional overrides
#SCAN_INTERVAL_SECONDS=90
#WALLET_KEYFILE=wallet.json
#STATE_FILE=state.json
